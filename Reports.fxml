<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="620.0" prefWidth="980.0" style="-fx-background-color: transparent;" stylesheets="@Reports.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Controllers.ReportsController">

    <children>
        <!-- Filters Row -->
        <ChoiceBox fx:id="chartTypeChoiceBox" layoutY="20.0" prefWidth="200.0" styleClass="choice-box" AnchorPane.leftAnchor="40.0" />
        <DatePicker fx:id="fromDatePicker" layoutY="20.0" prefWidth="150.0" styleClass="date-picker" AnchorPane.leftAnchor="260.0" />
        <DatePicker fx:id="toDatePicker" layoutY="20.0" prefWidth="150.0" styleClass="date-picker" AnchorPane.leftAnchor="430.0" />

        <!-- Side Reports Panel -->
        <VBox fx:id="reportsPanel" spacing="10" styleClass="vbox-rounded" AnchorPane.bottomAnchor="40.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="40.0"> <!-- anchors left so it stretches next to chart -->
            <children>
                <Label styleClass="section-title" text="REPORTS" />
                <Line endX="200" startX="0" stroke="#1a00ff" strokeWidth="2" />

                <!-- Transaction Summary -->
                <Label styleClass="section-subtitle" text="Average Revenue:" />
                <Label fx:id="avgRevenueLabel" maxWidth="Infinity" styleClass="label-info-box" />

                <Label styleClass="section-subtitle" text="Peak Revenue in selected range:" />
                <Label fx:id="peakRevenueLabel" maxWidth="Infinity" styleClass="label-info-box" />

                <Label styleClass="section-subtitle" text="Lowest Revenue in selected range:" />
                <Label fx:id="lowestRevenueLabel" maxWidth="Infinity" styleClass="label-info-box" />

                <Label styleClass="section-subtitle" text="Total in selected range:" />
                <Label fx:id="totalRevenueLabel" maxWidth="Infinity" styleClass="label-info-box" />

                <Label styleClass="section-subtitle" text="Average Park Time:" />
                <Label fx:id="avgParkTimeLabel" maxWidth="Infinity" styleClass="label-info-box" />

                <Label styleClass="section-subtitle" text="Total Park Time:" />
                <Label fx:id="totalParkTimeLabel" maxWidth="Infinity" styleClass="label-info-box" />

                <Label styleClass="section-subtitle" text="Total Number of Cars:" />
                <Label fx:id="totalCarsLabel" maxWidth="Infinity" styleClass="label-info-box" />

                <HBox alignment="CENTER" spacing="10">
                    <Button fx:id="saveButton" onAction="#onExportCSV" styleClass="btn-save" text="Save Report" />
                    <Button fx:id="printButton" onAction="#onExportPDF" styleClass="btn-print" text="Print Report" />
                </HBox>
            </children>
        </VBox>
      <AnchorPane fx:id="chartContainer1" layoutX="40.0" layoutY="81.0" prefHeight="290.0" prefWidth="580.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="360.0" AnchorPane.topAnchor="80.0">
         <children>
            <AreaChart fx:id="revenueChart" layoutX="-36.0" layoutY="-58.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
              <xAxis>
                <CategoryAxis side="BOTTOM" />
              </xAxis>
              <yAxis>
                <NumberAxis side="LEFT" />
              </yAxis>
            </AreaChart>
         </children>
      </AnchorPane>
      <AnchorPane fx:id="chartContainer2" layoutX="40.0" layoutY="376.8" prefHeight="290.0" prefWidth="580.0" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="360.0">
         <children>
            <AreaChart fx:id="carsChart" layoutX="-6.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="-6.0" AnchorPane.rightAnchor="6.0" AnchorPane.topAnchor="0.0">
              <xAxis>
                <CategoryAxis side="BOTTOM" />
              </xAxis>
              <yAxis>
                <NumberAxis side="LEFT" />
              </yAxis>
            </AreaChart>
         </children>
      </AnchorPane>
    </children>
</AnchorPane>
